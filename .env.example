# Server Port
PORT=3000

# Database Configuration (Hostinger / MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=movie_db

# API Source
API_BASE_URL=https://phimapi.com

# Deployment allowed origin
ALLOWED_ORIGIN=*

# Frontend URL for API calls
NEXT_PUBLIC_API_URL=http://localhost:3000

# Session Secret (min 32 characters)
SESSION_SECRET=changethissecret12345678901234567890

# SMTP — gửi mã xác nhận OTP qua email khi đăng ký
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=your_email@gmail.com

# Cookie phiên: đặt true khi site chạy HTTPS
COOKIE_SECURE=false

# Thanh toán — tài khoản nhận (mặc định đã là VietinBank 104867035330 - HOANG VAN DUC,
# chỉ điền khi muốn đổi). Mã ngân hàng theo vietqr.io: ICB = VietinBank, MB, VCB, TCB, ACB...
VIETQR_BANK_ID=ICB
VIETQR_BANK_NAME=VietinBank
VIETQR_ACCOUNT_NO=104867035330
VIETQR_ACCOUNT_NAME=HOANG VAN DUC
# Số ví hiển thị thêm cho MoMo / ZaloPay (tuỳ chọn)
MOMO_PHONE=
ZALOPAY_PHONE=
# Nội dung chuyển khoản = SĐT của tài khoản người nạp.
# Webhook SePay (sepay.vn) để tự động cộng tiền: URL = https://<domain>/api/payment/webhook
# Kiểu xác thực "API Key" với giá trị dưới. Bỏ trống = admin duyệt tay ở /admin/billing.
PAYMENT_WEBHOOK_KEY=

# ===== Phòng Xem Chung realtime (Socket.IO) — xem docs/WATCH_PARTY_REALTIME.md =====
# URL công khai của Socket.IO server mà TRÌNH DUYỆT kết nối tới.
# Biến NEXT_PUBLIC_* được "đóng gói" lúc build → phải có trong .env TRƯỚC khi chạy npm run build.
# VD cùng VPS qua Nginx:  https://socket.tenmien.com
# VD dịch vụ ngoài:       https://genzmovie-socket.onrender.com
NEXT_PUBLIC_SOCKET_URL=
# Cổng Socket.IO server lắng nghe (chạy bằng pm2: app "fullmovie-socket")
SOCKET_PORT=3001
# Domain được phép kết nối (phân tách bằng dấu phẩy). Bỏ trống = cho phép tất cả (đã có token bảo vệ)
SOCKET_CORS_ORIGIN=https://tenmien.com,https://www.tenmien.com
# Khoá ký token realtime — PHẢI GIỐNG NHAU giữa web Next.js và socket server.
# Bỏ trống = dùng SESSION_SECRET (tiện khi chạy chung 1 server).
SOCKET_SECRET=
